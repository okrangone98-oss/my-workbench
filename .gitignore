# ==========================================
# my-workbench .gitignore
# ==========================================

# 1. OS & System Files (운영체제 찌꺼기 파일 방지)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
Thumbs.db
$RECYCLE.BIN/

# 2. Security & Credentials (보안 및 인증 정보)
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
id_rsa
id_ed25519
credentials.json
client_secret.json
auth.json
*credentials*.json
service-account*.json
token.json
paypal_token.json
*.token.json
*.secret.json
secrets/
private/

# 3. IDE & Editor (개발 도구 설정 파일)
.vscode/
.idea/
*.swp
*.swo

# 4. Programming & Dependencies (언어별 패키지 및 임시 파일)
# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. Build Outputs
build/
dist/
coverage/

# 6. Logs & Databases
*.log
*.sqlite
*.sqlite3
*.db

# 7. Local Archives
archive_local/
temp/
