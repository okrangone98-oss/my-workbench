# ==========================================
# my-workbench .gitignore
# ==========================================

# 1. OS & System Files (운영체제 찌꺼기 파일 방지)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
Thumbs.db
$RECYCLE.BIN/

# 2. Security & Credentials (보안 및 인증 정보 - PRD 필수 원칙)
.env
.env.*
*.pem
*.key
credentials.json
client_secret.json
auth.json
secrets/
private/

# 3. IDE & Editor (개발 도구 설정 파일)
.vscode/
.idea/
*.swp
*.swo

# 4. Programming & Dependencies (언어별 패키지 및 임시 파일)
# Python (AI 에이전트 및 데이터 처리용)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Node.js (웹 및 프론트엔드 개발용)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. Logs & Databases (로그 및 로컬 DB 파일)
*.log
*.sqlite
*.sqlite3
*.db

# 6. Local Archives (GitHub에 올리지 않을 로컬 전용 아카이브 폴더)
archive_local/
temp/
